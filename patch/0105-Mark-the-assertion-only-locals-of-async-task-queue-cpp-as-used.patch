From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Subject: [PATCH] Mark the assertion-only locals of async_task_queue.cpp as used

async_task_queue.cpp declares locals that only D_ASSERT() reads (drained, result),
so in a release build, where D_ASSERT() expands to nothing, they are unused
and -Wunused-variable or -Wunused-but-set-variable says so. Each is cast
to void after its declaration, which changes no behavior.

Carried here until upstream takes it; not proposed upstream yet.

---
diff --git a/src/duckdb/src/common/serializer/async_task_queue.cpp b/src/duckdb/src/common/serializer/async_task_queue.cpp
--- a/src/duckdb/src/common/serializer/async_task_queue.cpp
+++ b/src/duckdb/src/common/serializer/async_task_queue.cpp
@@ -94,6 +94,7 @@ AsyncTaskQueue::~AsyncTaskQueue() {
 	lock_guard<mutex> guard(lock);
 	auto drained = pending_requests.empty() && pending_bytes == 0 && in_flight_bytes == 0 && active_tasks == 0 &&
 	               pending_tasks == 0;
+	(void)drained;
 	D_ASSERT(closed || drained);
 	D_ASSERT(!closed || drained);
 }
@@ -274,6 +275,7 @@ void AsyncTaskQueue::WorkOnPendingTask() {
 		return;
 	}
 	auto result = task->Execute(TaskExecutionMode::PROCESS_ALL);
+	(void)result;
 	D_ASSERT(result != TaskExecutionResult::TASK_BLOCKED);
 	task.reset();
 }
@@ -384,6 +386,7 @@ ManagedAsyncTaskQueue::ManagedAsyncTaskQueue(ClientContext &client_context_p, id
 ManagedAsyncTaskQueue::~ManagedAsyncTaskQueue() {
 	lock_guard<mutex> guard(lock);
 	auto drained = pending_requests.empty() && pending_bytes == 0 && submitted_bytes == 0 && submitted_requests == 0;
+	(void)drained;
 	D_ASSERT(closed || drained);
 	D_ASSERT(!closed || drained);
 }

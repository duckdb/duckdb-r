From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 23:44:15 +0000
Subject: [PATCH] Compile the copy executor's assert-only task result only when asserts are on

CopyFileLifecycleExecutor::WorkOnTask() keeps the task's result in a
local that only D_ASSERT() reads, so in a release build, where
D_ASSERT() expands to nothing, -Wunused-variable reports it. Upstream
later guards the local with D_ASSERT_IS_ENABLED; this is that text.

Carried here until the engine brings the same change.

---
 src/duckdb/src/execution/operator/persistent/physical_copy_to_file.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/duckdb/src/execution/operator/persistent/physical_copy_to_file.cpp b/src/duckdb/src/execution/operator/persistent/physical_copy_to_file.cpp
index 44d5367d39..75f240a7eb 100644
--- a/src/duckdb/src/execution/operator/persistent/physical_copy_to_file.cpp
+++ b/src/duckdb/src/execution/operator/persistent/physical_copy_to_file.cpp
@@ -381,8 +381,12 @@ bool CopyFileLifecycleExecutor::WorkOnTask(bool throw_error) {
 	if (!executor.GetTask(task)) {
 		return false;
 	}
+#ifdef D_ASSERT_IS_ENABLED
 	const auto result = task->Execute(TaskExecutionMode::PROCESS_ALL);
 	D_ASSERT(result != TaskExecutionResult::TASK_BLOCKED);
+#else
+	task->Execute(TaskExecutionMode::PROCESS_ALL);
+#endif
 	task.reset();
 	if (throw_error) {
 		ThrowError();

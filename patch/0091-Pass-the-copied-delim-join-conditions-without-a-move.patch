From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 07:10:36 +0000
Subject: [PATCH] Pass the copied delim join conditions without a move

Deliminator::RemoveInequalityJoinWithDelimGet() moves the temporaries
that Copy() returns into the join condition, which prevents copy
elision, so -Wpessimizing-move reports both arguments. Upstream later
passes the temporaries as they are; this is that text.

Carried here until the engine brings the same change.

---
 src/duckdb/src/optimizer/deliminator.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/duckdb/src/optimizer/deliminator.cpp b/src/duckdb/src/optimizer/deliminator.cpp
index 042db792b2..d1f6f92da0 100644
--- a/src/duckdb/src/optimizer/deliminator.cpp
+++ b/src/duckdb/src/optimizer/deliminator.cpp
@@ -383,8 +383,8 @@ bool Deliminator::RemoveInequalityJoinWithDelimGet(LogicalComparisonJoin &delim_
 						final_comparison = ExpressionType::COMPARE_EQUAL;
 					}
 					delim_conditions[cond_idx] =
-					    JoinCondition(std::move(delim_conditions[cond_idx].LeftReference()->Copy()),
-					                  std::move(delim_conditions[cond_idx].RightReference()->Copy()), final_comparison);
+					    JoinCondition(delim_conditions[cond_idx].LeftReference()->Copy(),
+					                  delim_conditions[cond_idx].RightReference()->Copy(), final_comparison);
 				}
 				found = true;
 				break;

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kirill =?UTF-8?q?M=C3=BCller?= <kirill@cynkra.com>
Date: Tue, 17 Nov 2026 16:00:00 +0100
Subject: [PATCH] Recognize UNC paths spelled with forward slashes on Windows

Path::FromString() took a path for a UNC path only when it started with two
backslashes, and ParseUNCScheme() split server and share at backslashes
alone. Windows accepts either separator in a UNC prefix, so
"//server/share/..." and mixed spellings were parsed as relative or rooted
paths, and opening a database or globbing files below such a share failed
(#2882). The prefix checks now accept either separator, through the new
Windows-only static member Path::StartsWithAnySeparator(), the server/share
split looks for both, and the authority is rendered with a backslash as when
spelled with backslashes. The change is Windows-only.

Confirmed on windows-latest, unpatched build failing exactly the reported
checks and tests and the patched build none:
https://github.com/duckdb/duckdb-r/actions/runs/44142768000

Carried here until upstream takes it; not proposed upstream yet.
---
diff --git a/src/duckdb/src/common/path.cpp b/src/duckdb/src/common/path.cpp
--- a/src/duckdb/src/common/path.cpp
+++ b/src/duckdb/src/common/path.cpp
@@ -60,7 +60,7 @@ Path Path::FromString(const string &raw) {
 		path_offset = ParseFileSchemes(raw, parsed);
 	}
 #if defined(_WIN32)
-	else if (raw.size() >= 5 && StringUtil::StartsWith(raw, R"(\\)") && raw.find_first_of('\\', 3) != string::npos) {
+	else if (raw.size() >= 5 && StartsWithAnySeparator(raw, R"(\\)") && raw.find_first_of(R"(/\)", 3) != string::npos) {
 		path_offset = ParseUNCScheme(raw, parsed);
 	}
 #endif
@@ -317,6 +317,20 @@ size_t Path::ParseFileSchemes(const string &input, Path &parsed) {
 }
 
 #if defined(_WIN32)
+// Windows accepts either separator in a UNC prefix: "\\server\share", "//server/share" and "\\?\UNC\" alike
+bool Path::StartsWithAnySeparator(const string &input, const string &prefix) {
+	if (input.size() < prefix.size()) {
+		return false;
+	}
+	for (size_t i = 0; i < prefix.size(); i++) {
+		const bool match = IsPathSeparator(prefix[i]) ? IsPathSeparator(input[i]) : input[i] == prefix[i];
+		if (!match) {
+			return false;
+		}
+	}
+	return true;
+}
+
 //
 // UNC Scheme as we handle it:
 // - scheme = "\\"
@@ -325,12 +339,12 @@ size_t Path::ParseFileSchemes(const string &input, Path &parsed) {
 // - path = < the rest >
 //
 size_t Path::ParseUNCScheme(const string &input, Path &parsed) {
-	D_ASSERT(input.size() >= 4 && input[0] == '\\' && input[1] == '\\');
+	D_ASSERT(input.size() >= 4 && IsPathSeparator(input[0]) && IsPathSeparator(input[1]));
 
 	static const char extended_prefix[] = R"(\\?\)";
 	static const char extended_unc_prefix[] = R"(\\?\UNC\)";
-	const bool extended = StringUtil::StartsWith(input, extended_prefix);
-	const bool extended_unc = extended && StringUtil::StartsWith(input, extended_unc_prefix);
+	const bool extended = StartsWithAnySeparator(input, extended_prefix);
+	const bool extended_unc = extended && StartsWithAnySeparator(input, extended_unc_prefix);
 
 	parsed.separator = '\\';
 
@@ -341,7 +355,7 @@ size_t Path::ParseUNCScheme(const string &input, Path &parsed) {
 	}
 
 	const auto server_begin = extended_unc ? sizeof(extended_unc_prefix) - 1 : 2;
-	const auto share_begin = input.find_first_of('\\', server_begin) + 1;
+	const auto share_begin = input.find_first_of(R"(/\)", server_begin) + 1;
 	auto pos = input.find_first_of("/\\", share_begin);
 	const auto share_len = (pos == string::npos ? input.size() : pos) - share_begin;
 	if (share_begin - server_begin <= 1 || share_len == 0) {
@@ -350,6 +364,8 @@ size_t Path::ParseUNCScheme(const string &input, Path &parsed) {
 
 	parsed.scheme = extended_unc ? extended_unc_prefix : R"(\\)";
 	parsed.authority = input.substr(server_begin, share_begin + share_len - server_begin);
+	// render "server/share" as "server\share", as when spelled with backslashes
+	parsed.authority[share_begin - 1 - server_begin] = '\\';
 	parsed.anchor = '\\';
 	parsed.is_absolute = true;
 	return (pos == string::npos || pos + 1 >= input.size()) ? input.size() : pos + 1;
diff --git a/src/duckdb/src/include/duckdb/common/path.hpp b/src/duckdb/src/include/duckdb/common/path.hpp
--- a/src/duckdb/src/include/duckdb/common/path.hpp
+++ b/src/duckdb/src/include/duckdb/common/path.hpp
@@ -154,6 +154,7 @@ private:
 	static size_t ParseFileSchemes(const string &input, Path &parsed);
 #if defined(_WIN32)
 	static size_t ParseUNCScheme(const string &input, Path &parsed);
+	static bool StartsWithAnySeparator(const string &input, const string &prefix);
 #endif
 };
 

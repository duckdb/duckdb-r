From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Subject: [PATCH] Mark the assertion-only locals of physical_copy_to_file.cpp as used

physical_copy_to_file.cpp declares locals that only D_ASSERT() reads (batch_idx, created_entry, result),
so in a release build, where D_ASSERT() expands to nothing, they are unused
and -Wunused-variable or -Wunused-but-set-variable says so. Each is cast
to void after its declaration, which changes no behavior.

Carried here until upstream takes it; not proposed upstream yet.

---
diff --git a/src/duckdb/src/execution/operator/persistent/physical_copy_to_file.cpp b/src/duckdb/src/execution/operator/persistent/physical_copy_to_file.cpp
--- a/src/duckdb/src/execution/operator/persistent/physical_copy_to_file.cpp
+++ b/src/duckdb/src/execution/operator/persistent/physical_copy_to_file.cpp
@@ -1548,6 +1548,7 @@ bool CopyFileLifecycleExecutor::WorkOnTask(bool throw_error) {
 		return false;
 	}
 	const auto result = task->Execute(TaskExecutionMode::PROCESS_ALL);
+	(void)result;
 	D_ASSERT(result != TaskExecutionResult::TASK_BLOCKED);
 	task.reset();
 	if (throw_error) {
@@ -1587,6 +1588,7 @@ void CopyFileLifecycleExecutor::ThrowError() {
 //===--------------------------------------------------------------------===//
 bool CopyDirectoryManager::EnsureDirectory(FileSystem &fs, const string &dir_path) {
 	bool created_entry = false;
+	(void)created_entry;
 	{
 		std::unique_lock<mutex> guard(lock);
 		while (true) {
@@ -2003,6 +2005,7 @@ optional<PartitionedCopyTask> PartitionedCopyHashGroup::TryNextBatchTask() {
 	// Update partition/batch counters
 	const auto batch_idx =
 	    batch_state.AddCollectionSlot(partitioned_copy.GetPartitionCollectionSchema(), task.end_idx - task.begin_idx);
+	(void)batch_idx;
 	D_ASSERT(batch_idx == task.batch_idx);
 
 	return task;

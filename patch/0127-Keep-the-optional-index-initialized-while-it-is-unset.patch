From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 14:00:00 +0000
Subject: [PATCH] Keep the optional index initialized while it is unset

optional_idx wraps std::optional<idx_t>, whose payload stays
indeterminate while the optional is empty. QueryLocation's constructor
tests `idx.IsValid() && idx.GetIndex() < INVALID_OFFSET`, and GCC 13 at
-O2 evaluates the comparison on the payload before the flag, so
valgrind reports a conditional jump on an uninitialised value in
Expression::Deserialize(). The result is right either way, but the
report fails checks run under valgrind. optional_idx now keeps a plain
index, zero while unset, next to a validity flag.

Carried here until upstream takes it; not proposed upstream yet.

---
 src/duckdb/src/include/duckdb/common/optional_idx.hpp | 19 +++++++++++--------
 1 file changed, 11 insertions(+), 8 deletions(-)

diff --git a/src/duckdb/src/include/duckdb/common/optional_idx.hpp b/src/duckdb/src/include/duckdb/common/optional_idx.hpp
index 540897cfe8..52bd205b63 100644
--- a/src/duckdb/src/include/duckdb/common/optional_idx.hpp
+++ b/src/duckdb/src/include/duckdb/common/optional_idx.hpp
@@ -18,7 +18,7 @@ public:
 	constexpr optional_idx() {
 	}
 	// NOLINTNEXTLINE: allow implicit conversion from idx_t
-	constexpr optional_idx(idx_t index_p) : index(index_p) {
+	constexpr optional_idx(idx_t index_p) : index(index_p), valid(true) {
 	}
 
 	static optional_idx Invalid() {
@@ -26,26 +26,27 @@ public:
 	}
 
 	bool IsValid() const {
-		return index.has_value();
+		return valid;
 	}
 
 	void SetInvalid() {
-		index.reset();
+		index = 0;
+		valid = false;
 	}
 
 	idx_t GetIndex() const {
-		if (!index.has_value()) {
+		if (!valid) {
 			ThrowNotSet();
 		}
-		return *index;
+		return index;
 	}
 
 	inline bool operator==(const optional_idx &rhs) const {
-		return index == rhs.index;
+		return valid == rhs.valid && (!valid || index == rhs.index);
 	}
 
 	inline bool operator!=(const optional_idx &rhs) const {
-		return index != rhs.index;
+		return !(*this == rhs);
 	}
 
 private:
@@ -53,7 +54,9 @@ private:
 	[[noreturn]] DUCKDB_API static void ThrowNotSet();
 
 private:
-	optional<idx_t> index;
+	//! Not std::optional: the index stays initialized while unset, since compilers may read it before the flag
+	idx_t index = 0;
+	bool valid = false;
 };
 
 } // namespace duckdb

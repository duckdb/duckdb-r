From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 22:00:00 +0000
Subject: [PATCH] Clamp the query location without branching on an unset index

optional_idx wraps std::optional<idx_t>, whose payload stays
indeterminate while the optional is empty. QueryLocation's constructor
tested `idx.IsValid() && idx.GetIndex() < INVALID_OFFSET`, and GCC 13
at -O2 branches on the payload comparison before it tests the flag, so
valgrind reports a conditional jump on an uninitialised value in
Expression::Deserialize(). The result is right either way, but the
report fails checks run under valgrind.

optional_idx gains GetIndexOr(), which returns the index or the given
fallback. QueryLocation now takes the index or INVALID_OFFSET and clamps
it to INVALID_OFFSET, which GCC compiles to conditional moves rather
than a branch on the payload. GetIndexOr() alone is not enough: an
`if (GetIndexOr(INVALID_OFFSET) < INVALID_OFFSET)` compiles to the same
branch as before.

Carried here until upstream takes it; not proposed upstream yet.

---
 src/duckdb/src/include/duckdb/common/optional_idx.hpp   | 5 +++++
 src/duckdb/src/include/duckdb/common/query_location.hpp | 5 ++---
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/src/duckdb/src/include/duckdb/common/optional_idx.hpp b/src/duckdb/src/include/duckdb/common/optional_idx.hpp
index 540897cfe8..ab2a798df2 100644
--- a/src/duckdb/src/include/duckdb/common/optional_idx.hpp
+++ b/src/duckdb/src/include/duckdb/common/optional_idx.hpp
@@ -40,6 +40,11 @@ public:
 		return *index;
 	}
 
+	//! The index if set, otherwise if_invalid
+	idx_t GetIndexOr(idx_t if_invalid) const {
+		return index.has_value() ? *index : if_invalid;
+	}
+
 	inline bool operator==(const optional_idx &rhs) const {
 		return index == rhs.index;
 	}
diff --git a/src/duckdb/src/include/duckdb/common/query_location.hpp b/src/duckdb/src/include/duckdb/common/query_location.hpp
index f9a32f796a..62350c8140 100644
--- a/src/duckdb/src/include/duckdb/common/query_location.hpp
+++ b/src/duckdb/src/include/duckdb/common/query_location.hpp
@@ -35,9 +35,8 @@ struct QueryLocation {
 	//! yields an invalid QueryLocation. Intended mainly for extensions and the few core sites that only have an
 	//! offset (casts, raw parser byte positions, legacy deserialization); prefer threading a real QueryLocation.
 	QueryLocation(optional_idx idx) { // NOLINT: allow implicit conversion from optional_idx
-		if (idx.IsValid() && idx.GetIndex() < INVALID_OFFSET) {
-			offset = static_cast<uint32_t>(idx.GetIndex());
-		}
+		auto index = idx.GetIndexOr(INVALID_OFFSET);
+		offset = static_cast<uint32_t>(index < INVALID_OFFSET ? index : INVALID_OFFSET);
 	}
 
 	static QueryLocation Invalid() {

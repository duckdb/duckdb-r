From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Subject: [PATCH] Mark the assertion-only locals of async_write_queue.cpp as used

async_write_queue.cpp declares locals that only D_ASSERT() reads (drained, result),
so in a release build, where D_ASSERT() expands to nothing, they are unused
and -Wunused-variable or -Wunused-but-set-variable says so. Each is cast
to void after its declaration, which changes no behavior.

Carried here until upstream takes it; not proposed upstream yet.

---
diff --git a/src/duckdb/src/common/serializer/async_write_queue.cpp b/src/duckdb/src/common/serializer/async_write_queue.cpp
--- a/src/duckdb/src/common/serializer/async_write_queue.cpp
+++ b/src/duckdb/src/common/serializer/async_write_queue.cpp
@@ -104,6 +104,7 @@ AsyncWriteQueue::~AsyncWriteQueue() {
 	lock_guard<mutex> guard(lock);
 	auto drained = pending_requests.empty() && pending_bytes == 0 && in_flight_bytes == 0 && active_tasks == 0 &&
 	               pending_tasks == 0 && scheduled_pending_bytes == 0 && pending_task_bytes.empty();
+	(void)drained;
 	D_ASSERT(closed || drained);
 	D_ASSERT(!closed || drained);
 }
@@ -394,6 +395,7 @@ void AsyncWriteQueue::WorkOnPendingTask() {
 		return;
 	}
 	auto result = task->Execute(TaskExecutionMode::PROCESS_ALL);
+	(void)result;
 	D_ASSERT(result != TaskExecutionResult::TASK_BLOCKED);
 	task.reset();
 }
@@ -533,6 +535,7 @@ ManagedAsyncWriteQueue::~ManagedAsyncWriteQueue() {
 	lock_guard<mutex> guard(lock);
 	auto drained = pending_writes.empty() && pending_bytes == 0 && external_pending_bytes == 0 &&
 	               submitted_bytes == 0 && submitted_requests == 0;
+	(void)drained;
 	D_ASSERT(closed || drained);
 	D_ASSERT(!closed || drained);
 }
@@ -1061,6 +1064,7 @@ ManagedAsyncWriteStreamQueue::~ManagedAsyncWriteStreamQueue() {
 	annotated_lock_guard<annotated_mutex> guard(lock);
 	auto drained = batch_depth == 0 && pending_writes.empty() && pending_bytes == 0 && submitted_bytes == 0 &&
 	               submitted_requests == 0;
+	(void)drained;
 	D_ASSERT(closed || drained);
 	D_ASSERT(!closed || drained);
 }

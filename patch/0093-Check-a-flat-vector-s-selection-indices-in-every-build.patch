From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 15:15:17 +0000
Subject: [PATCH] Check a flat vector's selection indices in every build

StandardVectorBuffer::VerifyInternal() reads each selection index into
a local that only D_ASSERT() reads, so in a release build, where
D_ASSERT() expands to nothing, -Wunused-variable reports it. Upstream
later turns the assertions into checks that throw; this is that text.

Carried here until the engine brings the same change.

---
 src/duckdb/src/common/vector/flat_vector.cpp | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/duckdb/src/common/vector/flat_vector.cpp b/src/duckdb/src/common/vector/flat_vector.cpp
index 92bda9c3c0..3693ace8dd 100644
--- a/src/duckdb/src/common/vector/flat_vector.cpp
+++ b/src/duckdb/src/common/vector/flat_vector.cpp
@@ -57,8 +57,14 @@ void StandardVectorBuffer::VerifyInternal(const LogicalType &type, const Selecti
 	if (sel.IsSet()) {
 		for (idx_t i = 0; i < count; i++) {
 			auto sel_idx = sel.get_index(i);
-			D_ASSERT(sel_idx <= validity.Capacity());
-			D_ASSERT(sel_idx <= Capacity());
+			if (sel_idx > validity.Capacity()) {
+				throw InternalException("Selection vector index %d out of range for validity capacity %d", sel_idx,
+				                        validity.Capacity());
+			}
+			if (sel_idx > Capacity()) {
+				throw InternalException("Selection vector index %d out of range for vector capacity %d", sel_idx,
+				                        Capacity());
+			}
 		}
 	} else if (vector_type == VectorType::FLAT_VECTOR) {
 		D_ASSERT(count <= validity.Capacity());

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 23:44:04 +0000
Subject: [PATCH] Build the row group pruner's pushdown column member by member

JoinFilterPushdownColumn gains a storage_type member, and the row
group pruner still brace-initializes the probe column alone, so
-Wmissing-field-initializers reports the site. Upstream later builds
the column member by member; this is that text.

Carried here until the engine brings the same change.

---
 src/duckdb/src/optimizer/row_group_pruner.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/duckdb/src/optimizer/row_group_pruner.cpp b/src/duckdb/src/optimizer/row_group_pruner.cpp
index f08a795c87..7420c5b5c7 100644
--- a/src/duckdb/src/optimizer/row_group_pruner.cpp
+++ b/src/duckdb/src/optimizer/row_group_pruner.cpp
@@ -131,7 +131,9 @@ optional_ptr<LogicalGet> RowGroupPruner::FindLogicalGet(const LogicalOrder &logi
 	const auto &primary_order = logical_order.orders[0];
 	auto &colref = primary_order.expression->Cast<BoundColumnRefExpression>();
 
-	vector<JoinFilterPushdownColumn> columns {JoinFilterPushdownColumn {colref.binding}};
+	JoinFilterPushdownColumn column;
+	column.probe_column_index = colref.binding;
+	vector<JoinFilterPushdownColumn> columns {std::move(column)};
 	vector<PushdownFilterTarget> pushdown_targets;
 	JoinFilterPushdownOptimizer::GetPushdownFilterTargets(*logical_order.children[0], std::move(columns),
 	                                                      pushdown_targets);

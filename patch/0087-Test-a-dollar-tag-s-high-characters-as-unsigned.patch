From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 02:10:14 +0000
Subject: [PATCH] Test a dollar tag's high characters as unsigned

BaseTokenizer::IsValidDollarTagCharacter() compares a plain char with
'\200' and '\377', which are negative where char is signed, so
-Wtype-limits reports a comparison that is always true. Upstream later
compares the character as unsigned; this is that text.

Carried here until the engine brings the same change.

---
 src/duckdb/src/parser/peg/tokenizer/base_tokenizer.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/duckdb/src/parser/peg/tokenizer/base_tokenizer.cpp b/src/duckdb/src/parser/peg/tokenizer/base_tokenizer.cpp
index f609604749..0f45001f45 100644
--- a/src/duckdb/src/parser/peg/tokenizer/base_tokenizer.cpp
+++ b/src/duckdb/src/parser/peg/tokenizer/base_tokenizer.cpp
@@ -204,7 +204,7 @@ bool BaseTokenizer::IsValidDollarTagCharacter(char c) {
 	if (c == '_') {
 		return true;
 	}
-	if (c >= '\200' && c <= '\377') {
+	if ((unsigned char)c >= (unsigned char)'\200') {
 		return true;
 	}
 	return false;
